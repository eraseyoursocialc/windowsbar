<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A small background helper for the parts of WindowsBar only Windows itself can do:
    media controls, the share sheet and fullscreen detection. It targets .NET Framework 4.8,
    which ships with every copy of Windows 10 and 11, so it needs nothing installed.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>WindowsBar.Helper</AssemblyName>
    <RootNamespace>WindowsBar.Helper</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
