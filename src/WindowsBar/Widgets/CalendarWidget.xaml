<UserControl x:Class="WindowsBar.Widgets.CalendarWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="236">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MonthText" Text="Oct" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,8,0" />

            <!-- Scroll sideways through the days of the month. -->
            <ScrollViewer x:Name="DayScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="DayScroller_PreviewMouseWheel">
                <StackPanel x:Name="DayStrip" Orientation="Horizontal" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
                <TextBlock x:Name="EmptyText" Text="Nothing for today" FontSize="11" Margin="0,4,0,0"
                           Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="EventList" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</UserControl>
