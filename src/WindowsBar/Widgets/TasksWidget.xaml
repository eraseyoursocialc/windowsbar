<UserControl x:Class="WindowsBar.Widgets.TasksWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="210">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Height="28" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10"
                           VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="New task…" FontSize="12" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource DimBrush}" IsHitTestVisible="False" />
                <TextBox x:Name="NewTask" Grid.Column="1" Style="{StaticResource PlainTextBox}" Margin="6,0,0,0"
                         VerticalAlignment="Center" KeyDown="NewTask_KeyDown" TextChanged="NewTask_TextChanged" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TaskList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row" Background="Transparent" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Check" Width="15" Height="15" CornerRadius="7.5" BorderThickness="1.5"
                                    BorderBrush="{StaticResource SubtleBrush}" Background="Transparent"
                                    Margin="2,0,8,0" Cursor="Hand" VerticalAlignment="Center"
                                    MouseLeftButtonUp="Check_Click">
                                <TextBlock x:Name="CheckMark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="8" Foreground="Black" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Text}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                    Content="&#xE711;" FontSize="8" Width="18" Height="18" Tag="9"
                                    Visibility="Hidden" ToolTip="Delete" Click="Remove_Click" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Check" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Check" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Label" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
