<UserControl x:Class="WindowsBar.Widgets.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Dashed outline, like a tray you can drop things into. -->
        <Rectangle x:Name="Outline" RadiusX="14" RadiusY="14" StrokeThickness="1.5"
                   StrokeDashArray="4 3" Stroke="{StaticResource FaintBrush}" />

        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22"
                       HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
            <TextBlock Text="Drop files here to keep them handy" FontSize="13" Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Drag them back out whenever you need them" FontSize="11"
                       HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Margin="8,6" PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="76" Margin="2" Padding="4,6" CornerRadius="10"
                                Background="Transparent" Cursor="Hand" ToolTip="{Binding Path}"
                                VerticalAlignment="Center"
                                MouseLeftButtonDown="Item_MouseLeftButtonDown" MouseMove="Item_MouseMove">
                            <Grid>
                                <StackPanel>
                                    <Image Source="{Binding Icon}" Width="36" Height="36" Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" />
                                </StackPanel>
                                <Button x:Name="RemoveButton" Style="{StaticResource IconButton}" Content="&#xE711;"
                                        FontSize="8" Width="18" Height="18" Tag="9" Background="#55000000"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-2,0"
                                        ToolTip="Remove from tray" Visibility="Hidden" Click="Remove_Click" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
