<UserControl x:Class="WindowsBar.Widgets.NotesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="256">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10,8,8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="Placeholder" Text="Notes for me." FontSize="12" Margin="2,0,0,0"
                           Foreground="{StaticResource DimBrush}" IsHitTestVisible="False" />
                <RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="White" CaretBrush="White" FontSize="12"
                             FontFamily="{StaticResource TextFont}"
                             SelectionBrush="{StaticResource AccentBrush}"
                             VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                             TextChanged="Editor_TextChanged">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>

                <!-- Formatting bar -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Button x:Name="ColorButton" Style="{StaticResource IconButton}" Width="22" Height="22"
                            Tag="5" HorizontalAlignment="Left" ToolTip="Text color" Click="Color_Click">
                        <Border x:Name="ColorSwatch" Width="12" Height="12" CornerRadius="3"
                                Background="{StaticResource AccentBrush}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Tag="5"
                                FontFamily="{StaticResource TextFont}" FontSize="11" Content="A"
                                ToolTip="Text size" Click="Size_Click" />
                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Tag="5"
                                FontFamily="{StaticResource TextFont}" FontSize="12" FontWeight="Bold" Content="B"
                                ToolTip="Bold (Ctrl+B)" Click="Bold_Click" />
                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Tag="5"
                                FontFamily="{StaticResource TextFont}" FontSize="12" FontStyle="Italic" Content="I"
                                ToolTip="Italic (Ctrl+I)" Click="Italic_Click" />
                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Tag="5"
                                ToolTip="Underline (Ctrl+U)" Click="Underline_Click">
                            <TextBlock Text="U" FontFamily="{StaticResource TextFont}" FontSize="12"
                                       TextDecorations="Underline" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Three separate note pages -->
        <StackPanel x:Name="PageButtons" Grid.Column="2" VerticalAlignment="Center" />
    </Grid>
</UserControl>
