<UserControl x:Class="WindowsBar.Widgets.MirrorWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="104">
    <Grid VerticalAlignment="Center">
        <Border x:Name="Circle" Width="100" Height="100" CornerRadius="50" Cursor="Hand"
                Background="{StaticResource CardBrush}" ToolTip="Mirror: a quick look at your webcam"
                MouseLeftButtonUp="Circle_Click">
            <Grid>
                <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PlaceholderGlyph" Text="&#xE722;" FontFamily="{StaticResource IconFont}"
                               FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
                    <TextBlock x:Name="PlaceholderText" Text="Mirror" FontSize="11" Margin="0,4,0,0"
                               HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
                </StackPanel>
                <!-- Flipped so it behaves like a real mirror. -->
                <Image x:Name="Preview" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </Image.RenderTransform>
                    <Image.Clip>
                        <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                    </Image.Clip>
                </Image>
            </Grid>
        </Border>
    </Grid>
</UserControl>
