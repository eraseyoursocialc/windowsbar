<UserControl x:Class="WindowsBar.Widgets.MediaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="270">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="78" Height="78" CornerRadius="12" Background="{StaticResource CardBrush}">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,78,78" RadiusX="12" RadiusY="12" />
                </Border.Clip>
                <Grid>
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="26"
                               Foreground="{StaticResource FaintBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="ArtImage" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="17" />
                <TextBlock x:Name="ArtistText" Text="Play music in any app" FontSize="11" Margin="0,2,0,0"
                           Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="Buttons" Orientation="Horizontal" Margin="-6,4,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="12"
                            Width="28" Height="28" Click="Previous_Click" ToolTip="Previous" />
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                            FontSize="15" Width="32" Height="28" Click="PlayPause_Click" ToolTip="Play / pause" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="12"
                            Width="28" Height="28" Click="Next_Click" ToolTip="Next" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="ProgressArea" Grid.Row="2" Visibility="Hidden">
            <Slider x:Name="SeekBar" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="1"
                    PreviewMouseLeftButtonDown="SeekBar_PreviewMouseDown"
                    PreviewMouseLeftButtonUp="SeekBar_PreviewMouseUp"
                    ValueChanged="SeekBar_ValueChanged" />
            <Grid Margin="0,1,0,0">
                <TextBlock x:Name="PositionText" Text="0:00" FontSize="10" Foreground="{StaticResource SubtleBrush}" />
                <TextBlock x:Name="DurationText" Text="0:00" FontSize="10" Foreground="{StaticResource SubtleBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
