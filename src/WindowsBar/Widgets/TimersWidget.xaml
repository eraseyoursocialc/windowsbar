<UserControl x:Class="WindowsBar.Widgets.TimersWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="256">
    <Grid>
        <!-- ===== Picking a time ===== -->
        <Grid x:Name="PickerView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9"
                    Width="20" Height="20" Tag="10" Background="#22FFFFFF"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1"
                    ToolTip="Back to running timers" Click="Back_Click" Visibility="Collapsed" />

            <!-- Hours : minutes : seconds, each one scrolls with the mouse wheel -->
            <StackPanel x:Name="Wheels" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Style="{StaticResource ChipButton}" Content="1m" Width="36" Height="22" FontSize="10"
                        ToolTip="Start a 1 minute timer" Click="Preset1_Click" />
                <Button Style="{StaticResource ChipButton}" Content="5m" Width="36" Height="22" FontSize="10"
                        Margin="0,6,0,8" ToolTip="Start a 5 minute timer" Click="Preset5_Click" />
                <Button x:Name="StartButton" Style="{StaticResource AccentCircleButton}" Content="&#xE768;"
                        ToolTip="Start" Click="Start_Click" />
            </StackPanel>
        </Grid>

        <!-- ===== Running timers ===== -->
        <Grid x:Name="RunningView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" Click="AddTimer_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Add Timer" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TimerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="10,4,4,4"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding RemainingText}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Content="{Binding PauseGlyph}"
                                                FontSize="10" Width="24" Height="24" Tag="12"
                                                ToolTip="Pause / resume" Click="ToggleTimer_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                                                FontSize="9" Width="24" Height="24" Tag="12"
                                                ToolTip="Remove" Click="RemoveTimer_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
