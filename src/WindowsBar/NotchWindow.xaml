<Window x:Class="WindowsBar.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:WindowsBar.Widgets"
        Title="WindowsBar"
        Width="1240" Height="270"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource TextFont}" Foreground="White"
        TextOptions.TextFormattingMode="Display">

    <!-- The window is a large transparent canvas; only the island catches the mouse,
         and while hidden the island has no size at all, so nothing covers the screen. -->
    <Grid>
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="200" Height="0" Opacity="0"
                Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource RimBrush}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,12,12"
                ClipToBounds="True" AllowDrop="True"
                PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
                MouseLeftButtonUp="Island_MouseLeftButtonUp"
                DragEnter="Island_DragEnter" DragOver="Island_DragOver"

                Drop="Island_Drop">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <!-- Light falling on the glass from above. -->
                <Border Background="{StaticResource SheenBrush}" IsHitTestVisible="False" />

                <!-- ===== Peeking / notices: the small tab ===== -->
                <Grid x:Name="CompactView" Margin="14,0" Height="22" VerticalAlignment="Bottom" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- A little grab bar when there's nothing else to show. -->
                    <Border x:Name="PeekHandle" Grid.ColumnSpan="3" Width="38" Height="4" CornerRadius="2"
                            Background="#59FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <Grid VerticalAlignment="Center">
                        <Border x:Name="CompactArt" Width="18" Height="18" CornerRadius="5"
                                Visibility="Collapsed" Background="#222">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,18,18" RadiusX="5" RadiusY="5" />
                            </Border.Clip>
                            <Image x:Name="CompactArtImage" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock x:Name="CompactGlyph" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>

                    <TextBlock x:Name="CompactText" Grid.Column="1" Margin="10,0"
                               FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <!-- Little bouncing bars while music plays. -->
                        <StackPanel x:Name="Equalizer" Orientation="Horizontal" Height="12" Visibility="Collapsed" />
                        <StackPanel x:Name="CompactCount" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock x:Name="CompactCountText" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== Open ===== -->
                <Grid x:Name="ExpandedView" Width="1200" Height="190"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: tabs on the left, battery and settings on the right -->
                    <Grid Margin="18,10,18,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button x:Name="NookTabButton" Style="{StaticResource ChipButton}" Click="NookTab_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Nook" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TrayTabButton" Style="{StaticResource ChipButton}" Margin="6,0,0,0"
                                    Click="TrayTab_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Tray" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="BatteryText" FontSize="11" Foreground="{StaticResource SubtleBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="GearButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                                    Width="28" Height="28" Tag="14" ToolTip="Settings" Click="Gear_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Nook: the widget strip (scroll sideways with the mouse wheel) ===== -->
                    <ScrollViewer x:Name="NookPanel" Grid.Row="1" Margin="0,4,0,18"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="NookPanel_PreviewMouseWheel">
                        <StackPanel x:Name="NookStrip" Orientation="Horizontal" Margin="22,0">
                            <w:MediaWidget x:Name="Media" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:MirrorWidget x:Name="Mirror" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:CalendarWidget x:Name="Calendar" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:NotesWidget x:Name="Notes" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:TimersWidget x:Name="Timers" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:TasksWidget x:Name="Tasks" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Tray: the file shelf ===== -->
                    <w:ShelfView x:Name="Shelf" Grid.Row="1" Margin="18,4,18,18" Visibility="Collapsed" />

                    <!-- ===== Settings, shown inside the island ===== -->
                    <Grid x:Name="SettingsPanel" Grid.Row="1" Margin="18,4,18,18" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="18,14" Width="300">
                                <StackPanel>
                                    <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}"
                                              Click="StartupToggle_Click">
                                        <StackPanel>
                                            <TextBlock Text="Start with Windows" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Ready as soon as you sign in" FontSize="11"
                                                       Foreground="{StaticResource SubtleBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12" />
                                    <CheckBox x:Name="FullscreenToggle" Style="{StaticResource ToggleSwitch}"
                                              Click="FullscreenToggle_Click">
                                        <StackPanel>
                                            <TextBlock Text="Stay away in fullscreen" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Games, videos and slideshows" FontSize="11"
                                                       Foreground="{StaticResource SubtleBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource ChipButton}" Height="34" Padding="16,0" Tag="17"
                                        HorizontalAlignment="Stretch" Click="DataFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Open data folder" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ChipButton}" Height="34" Padding="16,0" Tag="17"
                                        Margin="0,10,0,0" HorizontalAlignment="Stretch" Background="#33FF453A"
                                        Click="Quit_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Quit WindowsBar" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== Shown while dragging files onto the island ===== -->
                <Grid x:Name="DropView" Width="520" Height="136" Margin="0,8,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="TrayZone" Margin="16,8,0,16">
                        <Rectangle x:Name="TrayZoneOutline" RadiusX="16" RadiusY="16" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Stroke="{StaticResource FaintBrush}" Fill="#0DFFFFFF" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Files Tray" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="TrayZoneCount" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SubtleBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ShareZone" Grid.Column="2" Margin="0,8,16,16" CornerRadius="16"
                            Background="#260A84FF" BorderThickness="1.5" BorderBrush="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Nearby Share" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Send to a nearby PC or your phone" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
