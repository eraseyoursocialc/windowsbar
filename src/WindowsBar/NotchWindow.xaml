<Window x:Class="WindowsBar.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:WindowsBar.Widgets"
        Title="WindowsBar"
        Width="1240" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource TextFont}" Foreground="White"
        TextOptions.TextFormattingMode="Display">

    <!-- The window is a large transparent canvas; only the black island catches the mouse. -->
    <Grid>
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="180" Height="30"
                Background="Black" CornerRadius="0,0,15,15"
                ClipToBounds="True" AllowDrop="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
                MouseLeftButtonUp="Island_MouseLeftButtonUp"
                DragEnter="Island_DragEnter" DragOver="Island_DragOver"
                DragLeave="Island_DragLeave" Drop="Island_Drop">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5" />
            </Border.Effect>

            <Grid>
                <!-- ===== Collapsed: the small pill ===== -->
                <Grid x:Name="CompactView" Margin="12,0" Height="30" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center">
                        <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="5"
                                Visibility="Collapsed" Background="#222">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,20,20" RadiusX="5" RadiusY="5" />
                            </Border.Clip>
                            <Image x:Name="CompactArtImage" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock x:Name="CompactGlyph" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>

                    <TextBlock x:Name="CompactText" Grid.Column="1" Margin="10,0"
                               FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <!-- Little bouncing bars while music plays. -->
                        <StackPanel x:Name="Equalizer" Orientation="Horizontal" Height="14" Visibility="Collapsed" />
                        <StackPanel x:Name="CompactCount" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock x:Name="CompactCountText" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== Expanded ===== -->
                <Grid x:Name="ExpandedView" Width="1200" Height="186"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: tabs on the left, battery and settings on the right -->
                    <Grid Margin="16,8,16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button x:Name="NookTabButton" Style="{StaticResource ChipButton}" Click="NookTab_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Nook" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TrayTabButton" Style="{StaticResource ChipButton}" Margin="6,0,0,0"
                                    Click="TrayTab_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Tray" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="BatteryText" FontSize="11" Foreground="{StaticResource SubtleBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="GearButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                                    Width="26" Height="26" Tag="13" ToolTip="Settings" Click="Gear_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Nook: the widget strip (scroll sideways with the mouse wheel) ===== -->
                    <ScrollViewer x:Name="NookPanel" Grid.Row="1" Margin="0,6,0,16"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="NookPanel_PreviewMouseWheel">
                        <StackPanel Orientation="Horizontal" Margin="20,0">
                            <w:MediaWidget x:Name="Media" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:MirrorWidget x:Name="Mirror" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:CalendarWidget x:Name="Calendar" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:NotesWidget x:Name="Notes" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:TimersWidget x:Name="Timers" />
                            <Border Style="{StaticResource WidgetDivider}" />
                            <w:TasksWidget x:Name="Tasks" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Tray: the file shelf ===== -->
                    <w:ShelfView x:Name="Shelf" Grid.Row="1" Margin="16,6,16,16" Visibility="Collapsed" />
                </Grid>

                <!-- ===== Shown while dragging files onto the island ===== -->
                <Grid x:Name="DropView" Width="520" Height="132" Margin="0,8,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="TrayZone" Margin="16,8,0,16">
                        <Rectangle x:Name="TrayZoneOutline" RadiusX="14" RadiusY="14" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Stroke="{StaticResource FaintBrush}" Fill="#0DFFFFFF" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Files Tray" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="TrayZoneCount" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SubtleBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ShareZone" Grid.Column="2" Margin="0,8,16,16" CornerRadius="14"
                            Background="#260A84FF" BorderThickness="1.5" BorderBrush="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Nearby Share" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Send to a nearby PC or your phone" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
